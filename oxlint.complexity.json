{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [],
  "jsPlugins": ["oxlint-plugin-complexity"],
  "categories": {
    "correctness": "off"
  },
  "ignorePatterns": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**",
    "**/*.d.ts",
    "node_modules/**",
    ".next/**",
    ".build/**",
    "dist/**",
    "coverage/**"
  ],
  "overrides": [
    {
      "files": ["src/**/*.{ts,tsx}", "open-sse/**/*.{ts,tsx}", "bin/**/*.{ts,tsx}"],
      "rules": {
        "complexity": ["error", 15],
        "max-lines-per-function": [
          "error",
          { "max": 80, "skipBlankLines": true, "skipComments": true }
        ]
      }
    },
    {
      "files": ["src/**/*.{ts,tsx}", "open-sse/**/*.{ts,tsx}"],
      "rules": {
        "complexity/complexity": [
          "error",
          {
            "cyclomatic": 100000,
            "cognitive": 15,
            "minLines": 0,
            "enableExtraction": false,
            "nestingTipThreshold": 0,
            "elseIfChainThreshold": 0,
            "logicalOperatorThreshold": 0
          }
        ]
      }
    }
  ]
}
